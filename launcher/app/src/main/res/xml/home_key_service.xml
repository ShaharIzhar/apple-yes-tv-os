<?xml version="1.0" encoding="utf-8"?>
<!-- Home key, plus window changes from the stock home and the firmware's Home follow-ups
     (yes+ and the partner customizer's helper) only: a backstop for a missed Home key. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:packageNames="com.google.android.tvlauncher,il.co.yes.yesplus,com.nes.coreservice"
    android:notificationTimeout="0"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:description="@string/home_key_description" />
